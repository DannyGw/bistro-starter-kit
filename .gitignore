# ---------------------------------------------------------------------------
# Bistro Starter Kit — ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
bower_components/
jspm_packages/

# Lockfiles ARE committed: assets/css/tailwind.css is a build artefact, so the
# toolchain that produced it has to be reproducible (`npm ci` in CI).

# Build output / generated bundles
dist/
build/
out/
*.bundle.js
*.min.css

# Environment / secrets — NEVER commit real keys.
# Runtime configuration lives in config.js, which IS versioned.
# Keep private keys (Stripe secret, Supabase service_role, Chapa secret) server-side only.
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local scratch
scratch/
tmp/
*.tmp
